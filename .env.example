# ==============================================================================
# Environment Configuration Template (Zero Secrets)
# Copy this file to .env.local for local overrides.
# No secrets, API keys, or backend credentials are required to run this portfolio.
# ==============================================================================

# Optional: Custom Canonical Site URL
# Set this in your Vercel, Netlify, or Render dashboard environment settings
# to your live custom domain or generated platform URL.
# Examples:
#   Vercel:  https://apurv-nimbarge.vercel.app
#   Netlify: https://apurv-nimbarge.netlify.app
#   Render:  https://apurv-nimbarge.onrender.com
#   Custom:  https://apurvanimbarge.com
NEXT_PUBLIC_SITE_URL=https://apurvanimbarge.com

# Node Environment (automatically set by hosting platforms)
NODE_ENV=production

